{
  "permissions": {
    "allow": [
      "PowerShell(New-Item -ItemType Directory -Force \"c:\\\\Users\\\\Joshua Ihegihu\\\\elo-sports\\\\supabase\")",
      "PowerShell(Get-ChildItem -Path \"c:\\\\Users\\\\Joshua Ihegihu\\\\elo-sports\" -Recurse -Depth 3 | Where-Object { $_.PSIsContainer } | Select-Object -ExpandProperty FullName | Sort-Object)",
      "PowerShell(Get-ChildItem -Path \"c:\\\\Users\\\\Joshua Ihegihu\\\\elo-sports\" -Name -File -Recurse | Where-Object { $_ -match '\\\\.tsx?$' -and $_ -notmatch 'node_modules|\\\\.next' } | Sort-Object)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npx tsc *)",
      "Bash(npm run *)",
      "Bash(openssl rand *)",
      "Read(//dev/**)",
      "Bash(xxd -p)",
      "Bash(node -e ' *)",
      "Bash(npx next *)",
      "Bash(curl -s -m 90 \"http://localhost:3199/api/sync-odds\")",
      "Bash(curl -s -m 120 \"http://localhost:3000/api/sync-odds\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
